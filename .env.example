# Copy to .env and fill in your own Supabase project's values.
# These are the anon/publishable key + project URL — safe to expose to the
# browser ONLY because Row Level Security is enabled on every table. Never put
# a service-role key, DB connection string, or any other secret in this file
# or in any VITE_-prefixed variable — those are bundled into the client build.

SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
