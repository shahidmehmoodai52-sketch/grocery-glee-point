{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ubylxunrlzhijkelgxxx.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "tillix-pos-mcp",
      "version": "0.1.0",
      "title": "Tillix POS"
    },
    "tools": [
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Search inventory products by name, SKU, or barcode. Returns id, name, sku, barcode, unit, sell_price, cost_price, and stock.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Search text matched against name, sku, or barcode."
            },
            "limit": {
              "description": "Max rows to return. Default 20.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "low_stock",
        "title": "List low-stock products",
        "description": "List active products whose current stock is at or below the given threshold, ordered by stock ascending.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "threshold": {
              "description": "Stock threshold. Default 5.",
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "limit": {
              "description": "Max rows. Default 25.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "sales_summary",
        "title": "Sales summary",
        "description": "Summarize sales revenue, cost, profit, tax, discount, and invoice count over a recent window in days.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "days": {
              "description": "Look-back window in days. Default 7.",
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
